APP_NAME=Lamari
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
STAGING_PROTECTED=false
STAGING_USERNAME=
STAGING_PASSWORD=

APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lamari
DB_USERNAME=lamari
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMENT_PROVIDER=fake
FAKE_PAYMENT_SECRET=
MONO_API_BASE_URL=https://api.monobank.ua
MONO_MERCHANT_TOKEN=
MONO_FOP2_MERCHANT_TOKEN=
MONO_FOP3_MERCHANT_TOKEN=
MONO_WEBHOOK_PUBLIC_KEY=
MONO_FOP2_WEBHOOK_PUBLIC_KEY=
MONO_FOP3_WEBHOOK_PUBLIC_KEY=
# Mono merchant tokens belong only in the untracked .env file.

SALESDRIVE_ENABLED=false
SALESDRIVE_BASE_URL=https://lamari.salesdrive.me
SALESDRIVE_SOURCE=test.lamari.jewelry
SALESDRIVE_ORDERS_API_KEY=
SALESDRIVE_PAYMENTS_API_KEY=
SALESDRIVE_PENDING_STATUS="Очікує оплати"
SALESDRIVE_PAID_STATUS="Оплачено"
SALESDRIVE_PAYMENT_METHOD="Онлайн-оплата"
SALESDRIVE_DELIVERY_METHOD="Нова Пошта"
SALESDRIVE_ORGANIZATION_ID=
SALESDRIVE_ACCOUNT_NUMBER=
# SalesDrive keys belong only in the untracked .env file.

TELEGRAM_ORDERS_ENABLED=false
TELEGRAM_ORDERS_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_ORDERS_SOURCE=test.lamari.jewelry
# Telegram bot token belongs only in the untracked .env file.
